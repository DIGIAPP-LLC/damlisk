module Main where

template Limit
  with
    platform : Party
    cap : Decimal
  where
    signatory platform
    ensure cap > 0.0

template Shop
  with
    platform : Party
    owner : Party
    stock : Decimal
    currency : Text
    note : Text
  where
    signatory platform
    observer owner
    ensure stock > 0.0

    choice Buy : ContractId Shop
      with
        buyer : Party
        paid : Text
        amount : Decimal
        limitCid : ContractId Limit
      controller buyer, platform
      do
        limit <- fetch limitCid
        assertMsg "over cap" (amount <= limit.cap)
        create this with stock = stock - amount

    nonconsuming choice Describe : Text
      controller owner
      do pure note
