module Main where

validAmount : Decimal -> Bool
validAmount value = value > 0.0

template Iou
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory issuer
    observer owner

template Order
  with
    trader : Party
    price : Decimal
    quantity : Decimal
  where
    signatory trader
    ensure quantity > 0.0

template Bond
  with
    issuer : Party
    principal : Decimal
  where
    signatory issuer
    ensure principal > 0.0

template Token
  with
    owner : Party
    balance : Decimal
  where
    signatory owner
    ensure validAmount balance

template Counter
  with
    owner : Party
    count : Int
  where
    signatory owner
